# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.wrangler/
*.tsbuildinfo

# Python (legacy backend, removed at cutover)
.venv/
__pycache__/
*.py[cod]

# Secrets
.env
.env.*
!.env.example
.dev.vars

# CSVs are ignored by default; test fixtures at any depth are allowed.
*.csv
!**/tests/fixtures/*.csv
# Member exports are PII. Listed LAST so this rule wins even inside a fixtures dir.
user_download_members_*.csv

# Playwright output
e2e/test-results/
e2e/playwright-report/
e2e/.auth/

# Local
.DS_Store
.vscode/
.idea/
*.log
